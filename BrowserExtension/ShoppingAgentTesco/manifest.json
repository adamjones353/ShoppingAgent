{
  "manifest_version": 3,
  "name": "ShoppingAgent Tesco Helper",
  "version": "0.1.0",
  "description": "Guides Tesco shopping from the local ShoppingAgent desktop app.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.tesco.com/*",
    "http://127.0.0.1:51234/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.tesco.com/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
