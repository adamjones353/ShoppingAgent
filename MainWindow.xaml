<Window x:Class="ShoppingAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shopping Agent" Height="820" Width="1220" MinHeight="640" MinWidth="980">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="235" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" Padding="16">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Shopping Agent" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Local meal planning and shopping" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,16" />
                </StackPanel>
                <ListBox ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem}"
                         DisplayMemberPath="Title"
                         Background="{StaticResource PanelBrush}"
                         Foreground="{StaticResource TextBrush}"
                         BorderThickness="0" />
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Padding="24">
            <ContentControl Content="{Binding CurrentViewModel}" />
        </Border>
    </Grid>
</Window>
