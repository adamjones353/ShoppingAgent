<UserControl x:Class="ShoppingAgent.Views.MealsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Meals" FontSize="28" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBox Width="320" Text="{Binding NewMealName, UpdateSourceTrigger=PropertyChanged}" />
                <Button Content="Add meal" Command="{Binding AddQuickMealCommand}" />
                <Button Content="Remove selected" Command="{Binding DeleteSelectedMealCommand}" />
                <Button Content="Refresh" Command="{Binding LoadCommand}" />
            </StackPanel>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <DataGrid Grid.Column="0" ItemsSource="{Binding Meals}" SelectedItem="{Binding SelectedMeal}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="Effort" Binding="{Binding PrepEffort}" Width="*" />
                    <DataGridTextColumn Header="Minutes" Binding="{Binding CookingTimeMinutes}" Width="*" />
                    <DataGridCheckBoxColumn Header="Approved" Binding="{Binding Approved}" Width="*" />
                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="1" Background="{StaticResource PanelBrush}" Padding="16" Margin="16,8,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedMeal.Name}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedMeal.Description}" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,12" />
                    <TextBlock Text="Ingredients" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding SelectedMeal.Ingredients}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Ingredient.Name}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
