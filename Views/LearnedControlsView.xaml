<UserControl x:Class="ShoppingAgent.Views.LearnedControlsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Learned Browser Controls" FontSize="28" FontWeight="SemiBold" />
        <DataGrid ItemsSource="{Binding Controls}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Site" Binding="{Binding SiteName}" Width="*" />
                <DataGridTextColumn Header="Page" Binding="{Binding PageType}" Width="*" />
                <DataGridTextColumn Header="Purpose" Binding="{Binding Purpose}" Width="2*" />
                <DataGridTextColumn Header="Locator type" Binding="{Binding LocatorType}" Width="*" />
                <DataGridTextColumn Header="Locator" Binding="{Binding LocatorValue}" Width="3*" />
                <DataGridTextColumn Header="Role" Binding="{Binding AccessibleRole}" Width="*" />
                <DataGridTextColumn Header="Name" Binding="{Binding AccessibleName}" Width="2*" />
                <DataGridTextColumn Header="Confidence" Binding="{Binding ConfidenceScore}" Width="*" />
                <DataGridTextColumn Header="Failures" Binding="{Binding FailureCount}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
