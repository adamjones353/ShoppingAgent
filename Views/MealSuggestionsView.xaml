<UserControl x:Class="ShoppingAgent.Views.MealSuggestionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Meal Suggestions" FontSize="28" FontWeight="SemiBold" />
            <TextBox Height="70" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Ask OpenAI" Command="{Binding AskAiCommand}" />
                <Button Content="Approve selected" Command="{Binding ApproveCommand}" />
                <Button Content="Remove selected" Command="{Binding RemoveSuggestionCommand}" />
                <Button Content="Refresh" Command="{Binding LoadCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>
        <DataGrid ItemsSource="{Binding Suggestions}" SelectedItem="{Binding SelectedSuggestion}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="3*" />
                <DataGridTextColumn Header="Effort" Binding="{Binding PrepEffort}" Width="*" />
                <DataGridTextColumn Header="Minutes" Binding="{Binding CookingTimeMinutes}" Width="*" />
                <DataGridTextColumn Header="Tags" Binding="{Binding Tags}" Width="2*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
