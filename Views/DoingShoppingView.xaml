<UserControl x:Class="ShoppingAgent.Views.DoingShoppingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Doing Shopping" FontSize="28" FontWeight="SemiBold" />
            <WrapPanel Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Shopping list" Foreground="{StaticResource MutedTextBrush}" />
                    <ComboBox Width="340" ItemsSource="{Binding Lists}" SelectedItem="{Binding SelectedList}" DisplayMemberPath="Name" />
                </StackPanel>
                <Button Content="Start Shopping" Command="{Binding StartShoppingCommand}" />
                <Button Content="Open Login" Command="{Binding LoginCommand}" />
                <Button Content="Pick Delivery Slot" Command="{Binding OpenDeliverySlotsCommand}" />
                <Button Content="Resume Shopping" Command="{Binding ResumeShoppingCommand}" />
                <Button Content="Next Item" Command="{Binding NextItemCommand}" />
                <Button Content="I Added This To Basket" Command="{Binding ConfirmManualBasketCommand}" />
                <Button Content="Yes, Add To Basket" Command="{Binding AcceptCandidateCommand}" />
                <Button Content="No, Skip" Command="{Binding RejectCandidateCommand}" />
                <Button Content="Stop" Command="{Binding StopShoppingCommand}" />
                <Button Content="Refresh" Command="{Binding LoadCommand}" />
            </WrapPanel>
            <Border Background="{StaticResource PanelBrush}" Padding="14" Margin="0,10,0,4">
                <StackPanel>
                    <TextBlock Text="{Binding CurrentItem.Name, StringFormat=Current item: {0}}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CurrentTescoUrl}" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding CandidateProductName, StringFormat=Candidate: {0}}" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding CandidateProductUrl}" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding Status}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Items}">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Done" Binding="{Binding CheckedOff}" Width="*" />
                <DataGridCheckBoxColumn Header="Owned" Binding="{Binding AlreadyOwned}" Width="*" />
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" />
                <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="*" />
                <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
