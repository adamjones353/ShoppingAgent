<UserControl x:Class="ShoppingAgent.Views.WeeklyPlannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Weekly Planner" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="{Binding CurrentPlan.Name}" Foreground="{StaticResource MutedTextBrush}" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <ComboBox Width="300" ItemsSource="{Binding Meals}" SelectedItem="{Binding SelectedMeal}" DisplayMemberPath="Name" />
                <Button Content="Add today dinner" Command="{Binding AddDinnerCommand}" />
                <Button Content="Auto-suggest locally" Command="{Binding AutoSuggestCommand}" />
                <Button Content="Remove selected" Command="{Binding RemovePlannedMealCommand}" />
                <Button Content="Refresh" Command="{Binding LoadCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedTextBrush}" />
        </StackPanel>
        <DataGrid ItemsSource="{Binding PlannedMeals}" SelectedItem="{Binding SelectedPlannedMeal}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="*" />
                <DataGridTextColumn Header="Slot" Binding="{Binding Slot}" Width="*" />
                <DataGridTextColumn Header="Meal" Binding="{Binding Meal.Name}" Width="2*" />
                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="3*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
