<UserControl x:Class="ShoppingAgent.Views.MealHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Meal History" FontSize="28" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <ComboBox Width="260" ItemsSource="{Binding Meals}" SelectedItem="{Binding SelectedMeal}" DisplayMemberPath="Name" />
                <TextBox Width="70" Text="{Binding Rating}" />
                <CheckBox Content="Would have again" Foreground="{StaticResource TextBrush}" IsChecked="{Binding WouldHaveAgain}" VerticalAlignment="Center" Margin="0,0,12,4" />
                <TextBox Width="280" Text="{Binding Notes}" />
                <Button Content="Log eaten today" Command="{Binding AddHistoryCommand}" />
            </StackPanel>
        </StackPanel>
        <DataGrid ItemsSource="{Binding History}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="*" />
                <DataGridTextColumn Header="Meal" Binding="{Binding Meal.Name}" Width="2*" />
                <DataGridTextColumn Header="Rating" Binding="{Binding Rating}" Width="*" />
                <DataGridCheckBoxColumn Header="Again" Binding="{Binding WouldHaveAgain}" Width="*" />
                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="3*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
