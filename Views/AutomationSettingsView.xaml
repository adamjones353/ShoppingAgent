<UserControl x:Class="ShoppingAgent.Views.AutomationSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Automation Settings" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="OpenAI" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,4" />
        <TextBlock Text="API key" Foreground="{StaticResource MutedTextBrush}" />
        <TextBox Width="520" HorizontalAlignment="Left" Text="{Binding Settings.OpenAiApiKey, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="Model" Foreground="{StaticResource MutedTextBrush}" />
        <TextBox Width="240" HorizontalAlignment="Left" Text="{Binding Settings.OpenAiModel, UpdateSourceTrigger=PropertyChanged}" />
        <WrapPanel>
            <StackPanel><TextBlock Text="Daily budget USD" Foreground="{StaticResource MutedTextBrush}" /><TextBox Width="120" Text="{Binding Settings.DailyBudgetUsd}" /></StackPanel>
            <StackPanel><TextBlock Text="Monthly budget USD" Foreground="{StaticResource MutedTextBrush}" /><TextBox Width="140" Text="{Binding Settings.MonthlyBudgetUsd}" /></StackPanel>
            <StackPanel><TextBlock Text="Max tokens" Foreground="{StaticResource MutedTextBrush}" /><TextBox Width="120" Text="{Binding Settings.MaxTokensPerRequest}" /></StackPanel>
            <StackPanel><TextBlock Text="Max retries" Foreground="{StaticResource MutedTextBrush}" /><TextBox Width="100" Text="{Binding Settings.MaxAiRetries}" /></StackPanel>
        </WrapPanel>
        <TextBlock Text="Shopping automation" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,4" />
        <CheckBox Content="Enable AI browser fallback" Foreground="{StaticResource TextBrush}" IsChecked="{Binding Settings.EnableAiBrowserFallback}" />
        <CheckBox Content="Enable shopping automation" Foreground="{StaticResource TextBrush}" IsChecked="{Binding Settings.EnableShoppingAutomation}" />
        <TextBlock Text="Tesco login" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,4" />
        <TextBlock Text="Email" Foreground="{StaticResource MutedTextBrush}" />
        <TextBox Width="320" HorizontalAlignment="Left" Text="{Binding Settings.TescoEmail, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="Password" Foreground="{StaticResource MutedTextBrush}" />
        <TextBox Width="320" HorizontalAlignment="Left" Text="{Binding Settings.TescoPassword, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock Text="Stored locally in the app settings database on this PC." Foreground="{StaticResource MutedTextBrush}" />
        <StackPanel Orientation="Horizontal">
            <Button Width="140" HorizontalAlignment="Left" Content="Save settings" Command="{Binding SaveCommand}" />
            <Button Width="160" HorizontalAlignment="Left" Content="Install Chromium" Command="{Binding InstallChromiumCommand}" />
            <Button Width="190" HorizontalAlignment="Left" Content="Install Tesco Extension" Command="{Binding InstallExtensionCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedTextBrush}" />
    </StackPanel>
</UserControl>
