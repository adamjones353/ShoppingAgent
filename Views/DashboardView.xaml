<UserControl x:Class="ShoppingAgent.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Dashboard" FontSize="28" FontWeight="SemiBold" />
        <UniformGrid Columns="4" Margin="0,20,0,0">
            <Border Background="{StaticResource PanelBrush}" Padding="16" Margin="0,0,12,0">
                <StackPanel><TextBlock Text="Approved meals" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Text="{Binding MealCount}" FontSize="32" /></StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" Padding="16" Margin="0,0,12,0">
                <StackPanel><TextBlock Text="AI suggestions" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Text="{Binding SuggestionCount}" FontSize="32" /></StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" Padding="16" Margin="0,0,12,0">
                <StackPanel><TextBlock Text="History entries" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Text="{Binding HistoryCount}" FontSize="32" /></StackPanel>
            </Border>
            <Border Background="{StaticResource PanelBrush}" Padding="16">
                <StackPanel><TextBlock Text="Shopping lists" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Text="{Binding ShoppingListCount}" FontSize="32" /></StackPanel>
            </Border>
        </UniformGrid>
        <TextBlock Margin="0,24,0,0" Foreground="{StaticResource MutedTextBrush}" Text="The app works locally first. AI suggestions are stored for review, and shopping automation remains disabled until enabled in settings." />
    </StackPanel>
</UserControl>
