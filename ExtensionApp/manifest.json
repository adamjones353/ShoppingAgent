{
  "manifest_version": 3,
  "name": "Grocery Shopping Agent",
  "version": "0.1.0",
  "description": "Local-first meal planning and grocery shopping assistant.",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "permissions": ["storage", "sidePanel", "tabs"],
  "host_permissions": [
    "https://www.tesco.com/*",
    "https://*.tesco.com/*",
    "https://www.sainsburys.co.uk/*",
    "https://*.sainsburys.co.uk/*",
    "https://www.asda.com/*",
    "https://*.asda.com/*",
    "https://www.morrisons.com/*",
    "https://*.morrisons.com/*",
    "https://www.waitrose.com/*",
    "https://*.waitrose.com/*",
    "https://www.ocado.com/*",
    "https://*.ocado.com/*",
    "https://www.iceland.co.uk/*",
    "https://*.iceland.co.uk/*",
    "https://www.coop.co.uk/*",
    "https://*.coop.co.uk/*",
    "https://www.amazon.co.uk/*",
    "https://*.amazon.co.uk/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "action": {
    "default_title": "Grocery Shopping Agent",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.tesco.com/*",
        "https://*.sainsburys.co.uk/*",
        "https://*.asda.com/*",
        "https://*.morrisons.com/*",
        "https://*.waitrose.com/*",
        "https://*.ocado.com/*",
        "https://*.iceland.co.uk/*",
        "https://*.coop.co.uk/*",
        "https://*.amazon.co.uk/*"
      ],
      "js": ["src/content/content-db.js", "src/shared/retailers.js", "src/content/tesco-content.js"],
      "css": ["src/content/tesco-overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
