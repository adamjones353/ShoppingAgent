<Application x:Class="ShoppingAgent.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:ShoppingAgent.ViewModels"
             xmlns:views="clr-namespace:ShoppingAgent.Views">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="WindowColor">#101316</Color>
            <Color x:Key="PanelColor">#171B20</Color>
            <Color x:Key="PanelAltColor">#20262D</Color>
            <Color x:Key="TextColor">#CBD5E1</Color>
            <Color x:Key="MutedTextColor">#8793A3</Color>
            <Color x:Key="AccentColor">#5DBB8A</Color>

            <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
            <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
            <SolidColorBrush x:Key="PanelAltBrush" Color="{StaticResource PanelAltColor}" />
            <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource WindowBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Margin" Value="0,4,8,8" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="BorderBrush" Value="#334155" />
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Margin" Value="0,4,8,8" />
                <Setter Property="Padding" Value="6,4" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="Margin" Value="0,4,8,8" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="#06130D" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style TargetType="DataGrid">
                <Setter Property="Margin" Value="0,8,0,0" />
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                <Setter Property="Foreground" Value="#2F3742" />
                <Setter Property="RowBackground" Value="#F8FAFC" />
                <Setter Property="AlternatingRowBackground" Value="#E2E8F0" />
            </Style>

            <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:MealsViewModel}">
                <views:MealsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:MealSuggestionsViewModel}">
                <views:MealSuggestionsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:MealHistoryViewModel}">
                <views:MealHistoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:WeeklyPlannerViewModel}">
                <views:WeeklyPlannerView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:ShoppingListViewModel}">
                <views:ShoppingListView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:DoingShoppingViewModel}">
                <views:DoingShoppingView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:ProductMappingsViewModel}">
                <views:ProductMappingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:AutomationSettingsViewModel}">
                <views:AutomationSettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:AiUsageLogsViewModel}">
                <views:AiUsageLogsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewModels:LearnedControlsViewModel}">
                <views:LearnedControlsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
